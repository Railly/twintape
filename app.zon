.{
    .id = "dev.native_sdk.twintape",
    .name = "twintape",
    .display_name = "Twintape",
    .description = "Minimal meeting recorder skeleton: menu-bar app with a recording overlay border.",
    .version = "0.1.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{"macos"},
    // "microphone" is the mic track's TCC declaration. The system track
    // rides Screen Recording, which has no manifest form: macOS grants
    // it only through System Settings, so a refusal arrives as a
    // `failed` capture event (see docs/audio-capture#permissions).
    .permissions = .{ "view", "command", "microphone" },
    .capabilities = .{ "native_views", "gpu_surfaces", "tray", "global_hotkeys", "audio_capture", "shortcuts", "clipboard" },
    // System-wide toggle: fires while another app holds the keyboard, so
    // "start/stop recording" works without switching to twintape first
    // (the whole point of a background recorder). See docs/global-hotkeys.
    .global_hotkeys = .{
        .{ .id = "toggle-rec", .key = "r", .modifiers = .{ "primary", "shift" } },
    },
    // Esc, scoped to twintape's OWN key window (unlike the hotkey
    // above) - the naming dialog's Omitir path. A bare `escape` needs
    // no modifier (only enter/tab/space/backspace do, see
    // docs/keyboard-shortcuts#keys) and, being a `.shortcut` platform
    // event rather than canvas keyboard input, it reaches
    // `globalHotkeyEventFn` even while the naming field holds real
    // focus - see src/main.zig's file doc.
    .shortcuts = .{
        .{ .id = "naming-skip", .key = "escape" },
    },
    .shell = .{
        .windows = .{
            .{
                // The mandatory startup window, shrunk to an 8x8 sliver
                // (see src/main.zig's file doc for why it is NOT merged
                // with the recording border overlay: that merge made
                // this window come up frontmost with opaque black
                // content and real Cocoa chrome, a `makeMain`-only
                // activation path `activate_on_show` cannot reach). The
                // overlay itself is a separate `windows_fn`-declared
                // window (main.zig's `windows()`), oversized and
                // present only while recording.
                .label = "main",
                .title = "Twintape",
                .width = 8,
                .height = 8,
                .x = 0,
                .y = 0,
                .resizable = false,
                .restore_state = false,
                // Menu-bar-app shape: the red close button hides the
                // window instead of quitting (moot - this window shows
                // no chrome, ever); the app keeps running behind its
                // status item. See docs/tray#the-menu-bar-app-lifecycle.
                .close_policy = "hide",
                // Create-time-only overlay presentation: the manifest is
                // authoritative for these (docs/app-zon), so they must
                // match src/main.zig's shell_windows exactly.
                .titlebar = "chromeless",
                .transparent = true,
                .always_on_top = true,
                .click_through = true,
                .activate_on_show = false,
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Twintape", .accessibility_label = "Twintape", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "premultiplied", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
}
