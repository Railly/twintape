.{
    .id = "dev.native_sdk.twintape",
    .name = "twintape",
    .display_name = "Twintape",
    .description = "Minimal meeting recorder skeleton: menu-bar app with a recording overlay border.",
    .version = "0.1.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{"macos"},
    // "microphone" is the mic track's TCC declaration. The system track
    // rides Screen Recording, which has no manifest form: macOS grants
    // it only through System Settings, so a refusal arrives as a
    // `failed` capture event (see docs/audio-capture#permissions).
    .permissions = .{ "view", "command", "microphone" },
    .capabilities = .{ "native_views", "gpu_surfaces", "tray", "global_hotkeys", "audio_capture" },
    // System-wide toggle: fires while another app holds the keyboard, so
    // "start/stop recording" works without switching to twintape first
    // (the whole point of a background recorder). See docs/global-hotkeys.
    .global_hotkeys = .{
        .{ .id = "toggle-rec", .key = "r", .modifiers = .{ "primary", "shift" } },
    },
    .shell = .{
        .windows = .{
            .{
                // The pill itself (see src/main.zig's file doc). x/y
                // are a HARDCODED guess (1512x982, the 14" MacBook Pro
                // default in points), not computed: `native dev`
                // resolves the startup window's create-time frame from
                // THIS manifest, comptime, whenever app.zon declares
                // `.windows` (app_runner/root.zig's `manifestWindow` -
                // `RunOptions.default_frame`/`.restore_state` in
                // src/main.zig's `runWithOptions` call are DEAD CODE on
                // that path, only reached when app.zon declares no
                // windows at all). There is no env-var equivalent for a
                // manifest field the way TWINTAPE_SCREEN_W/H patches
                // the border overlay's runtime geometry, so an external
                // display or a different Mac's screen size ships this
                // slightly off-anchor until the SDK grows either a
                // manifest env-substitution or a runtime window-move
                // call.
                .label = "main",
                .title = "Twintape",
                .width = 120,
                .height = 8,
                .x = 696,
                .y = 970,
                .resizable = false,
                .restore_state = true,
                .restore_policy = "clamp_to_visible_screen",
                // Menu-bar-app shape: the red close button hides the
                // window instead of quitting; the app keeps running
                // behind its status item. See docs/tray#the-menu-bar-app-lifecycle.
                .close_policy = "hide",
                // Create-time-only overlay presentation: the manifest is
                // authoritative for these (docs/app-zon), so they must
                // match src/main.zig's shell_windows exactly.
                .titlebar = "chromeless",
                .transparent = true,
                .always_on_top = true,
                .click_through = false,
                .activate_on_show = false,
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Twintape status", .accessibility_label = "Twintape status", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "premultiplied", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
}
